<?php
/**
 * Class FieldtypeAssistedURL
 *
 * Modified by Adrian Jones to support storing URL as page ID
 *
 * @author Marco Stoll <m.stoll@core4.de>
 * @link http://core4.de CORE4 GmbH & Co. KG
 * @copyright Copyright (c) 2015, CORE4 GmbH & Co. KG
 * @license MIT http://opensource.org/licenses/MIT
 * @version 1.0.0
 * @see http://www.processwire.com
 * @filesource
 */

require_once __DIR__ . '/AssistedURLValue.php';

class FieldtypeAssistedURL extends FieldtypeURL {

    public static function getModuleInfo() {
        return [
            'title' => 'AssistedURL Field',
            'version' => '2.1.0',
            'summary' => 'Field that stores an URL providing controls for selecting internal pages and files.',
            'author' => 'Marco Stoll, Adrian Jones',
            'installs' => 'InputfieldAssistedURL',
        ];
    }

    public function init() {
        parent::init();
    }

    /**
     * Blank value for new pages
     */
    public function getBlankValue(Page $page, Field $field) {
        return new AssistedURLValue();
    }

    /**
     * Always returns AssistedURLValue.
     * Bare fragment links (e.g. "#anchor") pass through unchanged.
     */
    public function sanitizeValue(Page $page, Field $field, $value) {
        if($value instanceof AssistedURLValue) return $value;   // from wakeupValue or reassign

        $value = trim((string) $value);
        if($value === '') return new AssistedURLValue();
        if(preg_match('/^#[A-Za-z0-9\-_.:]+$/', $value)) return new AssistedURLValue($value);

        $sanitized = '';
        try {
            $sanitized = $this->wire('sanitizer')->url($value, [
                'allowRelative' => $field->get('noRelative') ? false : true,
                'allowIDN' => $field->get('allowIDN') ? true : false,
                'allowSchemes' => ['http', 'https', 'ftp', 'tel', 'mailto'],
                'stripQuotes' => $field->get('allowQuotes') ? false : true,
                'throw' => true,
            ]);
        } catch (\Throwable $e) {
            $this->error(
                sprintf($this->_('Invalid URL "%s": %s'), $value, $e->getMessage())
            );
        }

        if($sanitized === '') {
            $this->error(sprintf($this->_('Invalid URL "%s"'), $value));
            return new AssistedURLValue();
        }

        list(, $id) = $this->parseUrl($sanitized);
        return new AssistedURLValue($sanitized, $id);
    }

    /**
     * Keep the object when output formatting is on (parent would return a plain string).
     * URL is entity-encoded for output, same idea as FieldtypeURL.
     */
    public function ___formatValue(Page $page, Field $field, $value) {
        if(!$value instanceof AssistedURLValue) return parent::___formatValue($page, $field, $value);
        if($value->isEmpty()) return $value;
        return new AssistedURLValue(
            $this->wire('sanitizer')->entities1($value->url),
            $value->id
        );
    }

    public function getInputfield(Page $page, Field $field) {
        /** @var InputfieldAssistedURL $inputField */
        $inputField = $this->modules->get("InputfieldAssistedURL");
        $inputField->setPage($page);

        return $inputField;
    }

    /**
     * DB -> object
     */
    public function ___wakeupValue(Page $page, Field $field, $value) {
        $value = (string) $value;
        $urlParts = explode('?', $value, 2);
        if(ctype_digit($urlParts[0])) {
            $linkedPage = $this->wire('pages')->get((int) $urlParts[0]);
            if($linkedPage->id) {
                return new AssistedURLValue(
                    $linkedPage->url . (isset($urlParts[1]) ? '?' . $urlParts[1] : ''),
                    $linkedPage->id
                );
            }
        }
        return new AssistedURLValue($value);
    }

    /**
     * object -> DB (format unchanged: "123", "123?x=1" or raw URL)
     */
    public function ___sleepValue(Page $page, Field $field, $value) {
        $value = (string) $value;
        if($value === '') return '';

        list($value, $id, $query) = $this->parseUrl($value);
        if($id) return $id . ($query !== null ? '?' . $query : '');
        return $value;
    }

    /**
     * Normalizes URL (strips own host) and resolves a local path to a page id.
     *
     * @return array [normalized url, page id or 0, query string or null]
     */
    protected function parseUrl($value) {
        $value = (string) $value;
        if($value === '') return [$value, 0, null];

        foreach($this->wire('config')->httpHosts as $host) {
            $withoutHttp = preg_replace('#^https?://#', '', $value);
            if(strpos($withoutHttp, $host) === 0) {
                $value = str_replace($host, '', $value);
                $value = preg_replace('#^https?://#', '', $value);
            }
        }

        $urlParts = explode('?', $value, 2);
        $path = $urlParts[0];
        $query = isset($urlParts[1]) ? $urlParts[1] : null;
        $root = rtrim((string) $this->wire('config')->urls->root, '/');

        $isLocalPath = str_starts_with($path, '/')
            || ($root !== '' && str_starts_with($path, $root));

        if(!$isLocalPath || preg_match('#^[a-z][a-z0-9+.-]*:#i', $path)) {
            return [$value, 0, $query];
        }

        if($root !== '' && str_starts_with($path, $root)) {
            $urlPage = substr($path, strlen($root));
            if($urlPage === '') $urlPage = '/';
        } elseif(str_starts_with($path, '/')) {
            $urlPage = $path;
        } else {
            $urlPage = '/' . $path;
        }

        $p = $this->wire('pages')->get($urlPage);
        return [$value, $p->id ? (int) $p->id : 0, $query];
    }

}